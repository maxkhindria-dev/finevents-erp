includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app/
        - config/
        - database/
        - routes/
    # Level 8 (strict). "max" was tried in Phase 1 step 2: it mostly flags values
    # Laravel itself returns untyped (request closures, DB rows), so little gain.
    level: 8
